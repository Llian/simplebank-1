{
  "info": {
    "name": "Simple Bank API",
    "description": "Language-agnostic acceptance suite for the Simple Bank requirements doc.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080" },
    { "key": "username", "value": "alice" },
    { "key": "password", "value": "secret123" },
    { "key": "username2", "value": "bob" },
    { "key": "password2", "value": "secret456" },
    { "key": "access_token", "value": "" },
    { "key": "refresh_token", "value": "" },
    { "key": "access_token2", "value": "" },
    { "key": "account_id_usd", "value": "" },
    { "key": "account_id_usd_2", "value": "" }
  ],
  "item": [
    {
      "name": "Users",
      "item": [
        {
          "name": "Create User (Alice)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/users",
            "body": {
              "mode": "raw",
              "raw": "{\"username\":\"{{username}}\",\"password\":\"{{password}}\",\"full_name\":\"Alice A\",\"email\":\"alice@example.com\"}"
            }
          },
          "event": [{
            "listen": "test",
            "script": { "exec": [
              "pm.test('status 201', () => pm.response.to.have.status(201));",
              "pm.test('no password in response', () => pm.expect(pm.response.json()).to.not.have.property('hashed_password'));"
            ]}
          }]
        },
        {
          "name": "Create User (Bob)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/users",
            "body": {
              "mode": "raw",
              "raw": "{\"username\":\"{{username2}}\",\"password\":\"{{password2}}\",\"full_name\":\"Bob B\",\"email\":\"bob@example.com\"}"
            }
          },
          "event": [{
            "listen": "test",
            "script": { "exec": [
              "pm.test('status 201', () => pm.response.to.have.status(201));"
            ]}
          }]
        },
        {
          "name": "Create User Duplicate (Conflict)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/users",
            "body": {
              "mode": "raw",
              "raw": "{\"username\":\"{{username}}\",\"password\":\"{{password}}\",\"full_name\":\"Alice A\",\"email\":\"alice2@example.com\"}"
            }
          },
          "event": [{
            "listen": "test",
            "script": { "exec": [
              "pm.test('status 409', () => pm.response.to.have.status(409));",
              "pm.test('duplicate_username code', () => pm.expect(pm.response.json().error).to.eql('duplicate_username'));"
            ]}
          }]
        },
        {
          "name": "Login Invalid Password",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/users/login",
            "body": {
              "mode": "raw",
              "raw": "{\"username\":\"{{username}}\",\"password\":\"wrong-password\"}"
            }
          },
          "event": [{
            "listen": "test",
            "script": { "exec": [
              "pm.test('status 401', () => pm.response.to.have.status(401));",
              "pm.test('invalid_credentials code', () => pm.expect(pm.response.json().error).to.eql('invalid_credentials'));"
            ]}
          }]
        },
        {
          "name": "Login Alice",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/users/login",
            "body": {
              "mode": "raw",
              "raw": "{\"username\":\"{{username}}\",\"password\":\"{{password}}\"}"
            }
          },
          "event": [{
            "listen": "test",
            "script": { "exec": [
              "pm.test('status 200', () => pm.response.to.have.status(200));",
              "const body = pm.response.json();",
              "pm.environment.set('access_token', body.access_token);",
              "pm.environment.set('refresh_token', body.refresh_token);"
            ]}
          }]
        },
        {
          "name": "Login Bob",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/users/login",
            "body": {
              "mode": "raw",
              "raw": "{\"username\":\"{{username2}}\",\"password\":\"{{password2}}\"}"
            }
          },
          "event": [{
            "listen": "test",
            "script": { "exec": [
              "pm.test('status 200', () => pm.response.to.have.status(200));",
              "pm.environment.set('access_token2', pm.response.json().access_token);"
            ]}
          }]
        },
        {
          "name": "Renew Access Token",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/tokens/renew_access",
            "body": {
              "mode": "raw",
              "raw": "{\"refresh_token\":\"{{refresh_token}}\"}"
            }
          },
          "event": [{
            "listen": "test",
            "script": { "exec": [
              "pm.test('status 200', () => pm.response.to.have.status(200));",
              "pm.environment.set('access_token', pm.response.json().access_token);"
            ]}
          }]
        }
      ]
    },
    {
      "name": "Accounts",
      "item": [
        {
          "name": "Create Account USD (Alice)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{access_token}}" }] },
            "url": "{{baseUrl}}/accounts",
            "body": { "mode": "raw", "raw": "{\"currency\":\"USD\"}" }
          },
          "event": [{
            "listen": "test",
            "script": { "exec": [
              "pm.test('status 201', () => pm.response.to.have.status(201));",
              "const body = pm.response.json();",
              "pm.test('owner is alice', () => pm.expect(body.owner).to.eql(pm.environment.get('username')));",
              "pm.environment.set('account_id_usd', body.id);"
            ]}
          }]
        },
        {
          "name": "Create Duplicate Currency Account (Conflict)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{access_token}}" }] },
            "url": "{{baseUrl}}/accounts",
            "body": { "mode": "raw", "raw": "{\"currency\":\"USD\"}" }
          },
          "event": [{
            "listen": "test",
            "script": { "exec": [
              "pm.test('status 409', () => pm.response.to.have.status(409));",
              "pm.test('duplicate_account code', () => pm.expect(pm.response.json().error).to.eql('duplicate_account'));"
            ]}
          }]
        },
        {
          "name": "Create Account USD (Bob)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{access_token2}}" }] },
            "url": "{{baseUrl}}/accounts",
            "body": { "mode": "raw", "raw": "{\"currency\":\"USD\"}" }
          },
          "event": [{
            "listen": "test",
            "script": { "exec": [
              "pm.test('status 201', () => pm.response.to.have.status(201));",
              "pm.environment.set('account_id_usd_2', pm.response.json().id);"
            ]}
          }]
        },
        {
          "name": "Get Own Account (Alice)",
          "request": {
            "method": "GET",
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{access_token}}" }] },
            "url": "{{baseUrl}}/accounts/{{account_id_usd}}"
          },
          "event": [{
            "listen": "test",
            "script": { "exec": [
              "pm.test('status 200', () => pm.response.to.have.status(200));",
              "pm.test('owner matches', () => pm.expect(pm.response.json().owner).to.eql(pm.environment.get('username')));"
            ]}
          }]
        },
        {
          "name": "Get Other's Account (Forbidden)",
          "request": {
            "method": "GET",
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{access_token}}" }] },
            "url": "{{baseUrl}}/accounts/{{account_id_usd_2}}"
          },
          "event": [{
            "listen": "test",
            "script": { "exec": [
              "pm.test('status 403', () => pm.response.to.have.status(403));",
              "pm.test('forbidden code', () => pm.expect(pm.response.json().error).to.eql('forbidden'));"
            ]}
          }]
        },
        {
          "name": "List Accounts (Alice)",
          "request": {
            "method": "GET",
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{access_token}}" }] },
            "url": "{{baseUrl}}/accounts?page_id=1&page_size=5"
          },
          "event": [{
            "listen": "test",
            "script": { "exec": [
              "pm.test('status 200', () => pm.response.to.have.status(200));",
              "pm.test('is array', () => pm.expect(pm.response.json()).to.be.an('array'));"
            ]}
          }]
        }
      ]
    },
    {
      "name": "Transfers",
      "item": [
        {
          "name": "Currency Mismatch",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{access_token}}" }] },
            "url": "{{baseUrl}}/transfers",
            "body": {
              "mode": "raw",
              "raw": "{\"from_account_id\":{{account_id_usd}},\"to_account_id\":{{account_id_usd_2}},\"amount\":10,\"currency\":\"EUR\"}"
            }
          },
          "event": [{
            "listen": "test",
            "script": { "exec": [
              "pm.test('status 400', () => pm.response.to.have.status(400));",
              "pm.test('currency_mismatch code', () => pm.expect(pm.response.json().error).to.eql('currency_mismatch'));"
            ]}
          }]
        },
        {
          "name": "Insufficient Funds",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{access_token}}" }] },
            "url": "{{baseUrl}}/transfers",
            "body": {
              "mode": "raw",
              "raw": "{\"from_account_id\":{{account_id_usd}},\"to_account_id\":{{account_id_usd_2}},\"amount\":100,\"currency\":\"USD\"}"
            }
          },
          "event": [{
            "listen": "test",
            "script": { "exec": [
              "pm.test('status 400', () => pm.response.to.have.status(400));",
              "pm.test('insufficient_funds code', () => pm.expect(pm.response.json().error).to.eql('insufficient_funds'));"
            ]}
          }]
        },
        {
          "name": "Transfer From Account Not Owned (Forbidden)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{access_token2}}" }] },
            "url": "{{baseUrl}}/transfers",
            "body": {
              "mode": "raw",
              "raw": "{\"from_account_id\":{{account_id_usd}},\"to_account_id\":{{account_id_usd_2}},\"amount\":10,\"currency\":\"USD\"}"
            }
          },
          "event": [{
            "listen": "test",
            "script": { "exec": [
              "pm.test('status 403', () => pm.response.to.have.status(403));",
              "pm.test('forbidden code', () => pm.expect(pm.response.json().error).to.eql('forbidden'));"
            ]}
          }]
        },
        {
          "name": "Successful Transfer (requires seeded balance)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{access_token}}" }] },
            "url": "{{baseUrl}}/transfers",
            "body": {
              "mode": "raw",
              "raw": "{\"from_account_id\":{{account_id_usd}},\"to_account_id\":{{account_id_usd_2}},\"amount\":25,\"currency\":\"USD\"}",
              "options": { "raw": { "language": "json" } }
            },
            "description": "Only passes if fixtures seeded account_id_usd's balance >= 25 before this suite runs — there is no public deposit endpoint by design (see Scope)."
          },
          "event": [{
            "listen": "test",
            "script": { "exec": [
              "pm.test('status 200', () => pm.response.to.have.status(200));",
              "const body = pm.response.json();",
              "pm.test('entries recorded', () => { pm.expect(body.from_entry.amount).to.eql(-25); pm.expect(body.to_entry.amount).to.eql(25); });"
            ]}
          }]
        }
      ]
    }
  ]
}
